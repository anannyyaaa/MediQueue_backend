generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hospital {
  id                  String   @id @default(uuid())
  name                String
  area                String?
  pincode             String?
  totalBeds           Int?
  emergencyAvailable  Boolean  @default(false)
  departments         String?
  address             String?
  status              String   @default("Active")
  waitMinutes         Int      @default(0)
  crowdLevel          String   @default("Low")
  createdAt           DateTime @default(now())
}
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}